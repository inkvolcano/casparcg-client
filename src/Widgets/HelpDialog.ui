<?xml version="1.0" encoding="UTF-8"?>
<ui version="4.0">
 <class>HelpDialog</class>
 <widget class="QDialog" name="HelpDialog">
  <property name="geometry">
   <rect>
    <x>0</x>
    <y>0</y>
    <width>540</width>
    <height>460</height>
   </rect>
  </property>
  <property name="windowTitle">
   <string>Help</string>
  </property>
  <layout class="QGridLayout" name="gridLayout">
   <item row="1" column="1">
    <widget class="QPushButton" name="pushButtonOk">
     <property name="focusPolicy">
      <enum>Qt::NoFocus</enum>
     </property>
     <property name="text">
      <string>&amp;OK</string>
     </property>
    </widget>
   </item>
   <item row="0" column="0" colspan="2">
    <widget class="QPlainTextEdit" name="plainTextEdit">
     <property name="readOnly">
      <bool>true</bool>
     </property>
     <property name="plainText">
      <string>Default keys. The playout keys, trigger banks, preview toggle and autostep toggle can be changed in Settings &gt; Hotkeys; the editing keys are fixed.

F1
Function: Stop
Description: Call stop on selected item in the rundown.

F2
Function: Play
Description: Call play on selected item in the rundown.

F3
Function: Load
Description: Call load on selected item in the rundown.

F4
Function: Pause / Resume
Description: Call pause or resume on selected item in the rundown.

F5
Function: Next
Description: Call next on selected item in the rundown.

F6
Function: Update
Description: Call update on selected item in the rundown.

F7
Function: Invoke
Description: Call invoke on selected item in the rundown.

F8
Function: Preview
Description: Play selected item on the server's preview channel.

F10
Function: Clear
Description: Call clear on selected item in the rundown.

F11
Function: Clear Layer
Description: Call clear on selected items video layer in the rundown.

F12
Function: Clear Channel
Description: Call clear on selected items channel in the rundown.

Ctrl+1 - Ctrl+9
Function: Trigger banks
Description: Play the item assigned to trigger bank 1 to 9.

Ctrl+] / Ctrl+[
Function: Rundown tabs
Description: Switch to the next / previous rundown tab.

Ctrl+G / Ctrl+U
Function: Group / Ungroup
Description: Group / Ungroup one or more items in the rundown.

Ctrl+Shift+D
Function: Duplicate
Description: Duplicate selected item in the rundown.

Ctrl+D
Function: Disable / Enable
Description: A disabled item does not fire.

Ctrl+C / Ctrl+V
Function: Copy / Paste
Description: Copy / Paste selected item in the rundown.

Ctrl+X
Function: Cut
Description: Cut selected item in the rundown.

Ctrl+Up / Ctrl+Down
Function: Navigation.
Description: Move item up / down in the rundown.

Ctrl+Right / Ctrl+Left
Function: Navigation
Description: Move item in / out of a group in the rundown.

Delete
Function: Delete
Description: Delete item / group in the rundown.

Ctrl+Z / Ctrl+Y
Function: Undo / Redo
Description: Undo / redo the last change to the rundown.

Ctrl+F
Function: Search
Description: Search the rundown.

Ctrl+O / Ctrl+S / Ctrl+Shift+S
Function: Open / Save / Save As
Description: Open or save a rundown file.

Escape, twice within half a second
Function: Panic
Description: Clear every output on every server.

Ctrl+H
Function: Help
Description: Show this help dialog.</string>
     </property>
    </widget>
   </item>
   <item row="1" column="0">
    <spacer name="horizontalSpacer">
     <property name="orientation">
      <enum>Qt::Horizontal</enum>
     </property>
     <property name="sizeHint" stdset="0">
      <size>
       <width>40</width>
       <height>20</height>
      </size>
     </property>
    </spacer>
   </item>
  </layout>
 </widget>
 <resources/>
 <connections>
  <connection>
   <sender>pushButtonOk</sender>
   <signal>clicked()</signal>
   <receiver>HelpDialog</receiver>
   <slot>accept()</slot>
   <hints>
    <hint type="sourcelabel">
     <x>278</x>
     <y>429</y>
    </hint>
    <hint type="destinationlabel">
     <x>356</x>
